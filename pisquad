#!/usr/bin/env bash
set -euo pipefail

if ! command -v node >/dev/null 2>&1; then
  printf '%s\n' 'Error: pisquad requires Node.js 18 or newer.' >&2
  printf '%s\n' 'Install Node.js from https://nodejs.org/ or with nvm, then try again.' >&2
  exit 1
fi

node_major="$(node -p "process.versions.node.split('.')[0]" 2>/dev/null || true)"
if [[ ! "$node_major" =~ ^[0-9]+$ ]] || (( node_major < 18 )); then
  printf 'Error: pisquad requires Node.js >=18 (found %s).\n' "$(node --version 2>/dev/null || printf 'unknown')" >&2
  printf '%s\n' 'Upgrade Node.js at https://nodejs.org/ or with nvm, then try again.' >&2
  exit 1
fi

if command -v pisquad >/dev/null 2>&1; then
  exec pisquad "$@"
fi

if ! command -v npx >/dev/null 2>&1; then
  printf '%s\n' 'Error: npx is required. Install a current Node.js distribution and try again.' >&2
  exit 1
fi

exec npx --yes pisquad@latest "$@"
