{
  "name": "@nicklin/pisquad",
  "version": "0.2.0",
  "description": "Install and upgrade the pi-squad development foundation",
  "type": "module",
  "bin": {
    "pisquad": "dist/bin.js"
  },
  "files": [
    "dist",
    "assets",
    "README*.md",
    "LICENSE",
    "pisquad"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "node --test --import tsx test/**/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.0.0",
    "commander": "^12.1.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "tsx": "^4.23.11",
    "typescript": "^5.7.2"
  }
}
